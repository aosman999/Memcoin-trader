// GoldTrader PRO v2 — a complete, self-explaining trading workstation for
// XAUUSD. Two ways to use it:
//   (A) Follow the SIGNALS: when 5+/6 indicators align AND the tape is
//       trending, you get a BUY/SELL label with exact entry/stop/target.
//   (B) Find trades YOURSELF using the tools it draws: auto support &
//       resistance zones, Bollinger Bands, the EMA200 major trend, VWAP,
//       Supertrend, and RSI divergence — plus a live dashboard that tells
//       you what every indicator is doing right now.
//
// LIVE, not just history: the "NOW" bias box updates every bar and
// changes/clears the instant alignment is lost. Support/resistance lines
// auto-delete the moment price breaks them. Confirmed BUY/SELL arrows are
// bar-close and never repaint.
//
// Install: TradingView -> 1m XAUUSD -> Pine Editor (bottom tab) -> select
// all, delete, paste -> Save -> Add to chart. Remove older GoldTrader
// indicators first (hover the name -> X).
//@version=5
indicator("GoldTrader PRO v2", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 200)

// ================= INPUTS =================
grpS = "Signal engine"
votesNeeded = input.int(5, "Votes needed to signal (of 6)", minval = 4, maxval = 6, group = grpS)
adxMin      = input.float(18.0, "Minimum ADX (trend strength)", minval = 5, maxval = 40, group = grpS)
stopPct     = input.float(0.6, "Stop-loss %", minval = 0.1, step = 0.1, group = grpS)
tpPct       = input.float(1.2, "Take-profit %", minval = 0.2, step = 0.1, group = grpS)

grpT = "Tools (draw-your-own-trade)"
showSR   = input.bool(true, "Auto support/resistance", group = grpT)
pivLen   = input.int(8, "S/R swing sensitivity", minval = 3, maxval = 25, group = grpT)
maxSR    = input.int(4, "S/R levels each side", minval = 1, maxval = 8, group = grpT)
showBB   = input.bool(true, "Bollinger Bands (20,2)", group = grpT)
showEMA200 = input.bool(true, "EMA200 major trend", group = grpT)
showDiv  = input.bool(true, "RSI divergences", group = grpT)
showDash = input.bool(true, "Dashboard", group = grpT)

// ================= THE SIX VOTERS =================
emaFast = ta.ema(close, 20)
emaSlow = ta.ema(close, 75)
slope   = (emaSlow - emaSlow[5]) / (5 * emaSlow)
v1bull  = emaFast > emaSlow and slope > 0
v1bear  = emaFast < emaSlow and slope < 0

mtfBull = request.security(syminfo.tickerid, "15", ta.ema(close, 20) >= ta.ema(close, 20)[1], lookahead = barmerge.lookahead_off)
v2bull  = mtfBull
v2bear  = not mtfBull

[_, _, macdHist] = ta.macd(close, 12, 26, 9)
v3bull  = macdHist > 0
v3bear  = macdHist < 0

rsiV   = ta.rsi(close, 14)
v4bull = rsiV > 50
v4bear = rsiV < 50

[stValue, stDir] = ta.supertrend(3, 10)
v5bull = stDir < 0
v5bear = stDir > 0

vw     = ta.vwap(hlc3)
v6bull = close > vw
v6bear = close < vw

bulls = (v1bull ? 1 : 0) + (v2bull ? 1 : 0) + (v3bull ? 1 : 0) + (v4bull ? 1 : 0) + (v5bull ? 1 : 0) + (v6bull ? 1 : 0)
bears = (v1bear ? 1 : 0) + (v2bear ? 1 : 0) + (v3bear ? 1 : 0) + (v4bear ? 1 : 0) + (v5bear ? 1 : 0) + (v6bear ? 1 : 0)

[diP, diM, adxV] = ta.dmi(14, 14)
strongTape = adxV >= adxMin

buyState  = bulls >= votesNeeded and strongTape
sellState = bears >= votesNeeded and strongTape
buySig  = buyState and not buyState[1] and barstate.isconfirmed
sellSig = sellState and not sellState[1] and barstate.isconfirmed

// ================= CONTEXT PLOTS =================
plot(emaFast, "EMA20", color = color.new(color.teal, 45))
plot(emaSlow, "EMA75", color = color.new(color.orange, 45))
ema200 = ta.ema(close, 200)
plot(showEMA200 ? ema200 : na, "EMA200", color = color.new(color.purple, 20), linewidth = 2)
plot(stValue, "Supertrend", color = stDir < 0 ? color.new(color.green, 55) : color.new(color.red, 55), style = plot.style_linebr)
plot(vw, "VWAP", color = color.new(color.gray, 50), style = plot.style_circles)

bbBasis = ta.sma(close, 20)
bbDev   = 2.0 * ta.stdev(close, 20)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
pU = plot(showBB ? bbUpper : na, "BB upper", color = color.new(color.blue, 55))
pL = plot(showBB ? bbLower : na, "BB lower", color = color.new(color.blue, 55))
fill(pU, pL, color = showBB ? color.new(color.blue, 93) : na)

bgcolor(buyState ? color.new(color.green, 92) : sellState ? color.new(color.red, 92) : na, title = "aligned tape")

// ================= AUTO SUPPORT / RESISTANCE =================
// Pivot swing points become horizontal levels that extend right and are
// DELETED the moment price closes through them (so only live levels show).
var array<line>  resLines = array.new<line>()
var array<line>  supLines = array.new<line>()
var array<label> srLabels = array.new<label>()

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

if showSR and not na(ph)
    ln = line.new(bar_index - pivLen, ph, bar_index, ph, color = color.new(color.red, 30), width = 2, extend = extend.right)
    array.push(resLines, ln)
    if array.size(resLines) > maxSR
        line.delete(array.shift(resLines))
if showSR and not na(pl)
    ln = line.new(bar_index - pivLen, pl, bar_index, pl, color = color.new(color.green, 30), width = 2, extend = extend.right)
    array.push(supLines, ln)
    if array.size(supLines) > maxSR
        line.delete(array.shift(supLines))

// erase broken levels (resistance broken UP, support broken DOWN)
if showSR and barstate.isconfirmed
    if array.size(resLines) > 0
        for i = array.size(resLines) - 1 to 0
            ln = array.get(resLines, i)
            if close > line.get_y1(ln)
                line.delete(ln)
                array.remove(resLines, i)
    if array.size(supLines) > 0
        for i = array.size(supLines) - 1 to 0
            ln = array.get(supLines, i)
            if close < line.get_y1(ln)
                line.delete(ln)
                array.remove(supLines, i)

// ================= RSI DIVERGENCE =================
// bullish: price lower low, RSI higher low. bearish: mirror.
pivR = 5
phRSI = ta.pivothigh(rsiV, pivR, pivR)
plRSI = ta.pivotlow(rsiV, pivR, pivR)
var float lastPLprice = na
var float lastPLrsi   = na
var float lastPHprice = na
var float lastPHrsi   = na
bullDiv = false
bearDiv = false
if showDiv and not na(plRSI)
    curP = low[pivR]
    if not na(lastPLprice) and curP < lastPLprice and plRSI > lastPLrsi
        bullDiv := true
    lastPLprice := curP
    lastPLrsi   := plRSI
if showDiv and not na(phRSI)
    curP = high[pivR]
    if not na(lastPHprice) and curP > lastPHprice and phRSI < lastPHrsi
        bearDiv := true
    lastPHprice := curP
    lastPHrsi   := phRSI
plotshape(bullDiv, "bull div", shape.diamond, location.belowbar, color.new(color.lime, 0), text = "div", size = size.tiny, offset = -pivR)
plotshape(bearDiv, "bear div", shape.diamond, location.abovebar, color.new(color.orange, 0), text = "div", size = size.tiny, offset = -pivR)

// ================= CONFIRMED SIGNAL (non-repainting) =================
var line entryLn = na
var line slLn    = na
var line tpLn    = na
var label sigLb  = na
if buySig or sellSig
    line.delete(entryLn)
    line.delete(slLn)
    line.delete(tpLn)
    label.delete(sigLb)
    dir = buySig ? 1 : -1
    sl  = close * (1 - dir * stopPct / 100)
    tp  = close * (1 + dir * tpPct / 100)
    entryLn := line.new(bar_index, close, bar_index + 90, close, color = color.gray,  style = line.style_dotted, width = 2)
    slLn    := line.new(bar_index, sl,    bar_index + 90, sl,    color = color.red,   style = line.style_dashed, width = 2)
    tpLn    := line.new(bar_index, tp,    bar_index + 90, tp,    color = color.green, style = line.style_dashed, width = 2)
    txt = (buySig ? "BUY (go long)\n" : "SELL (go short)\n") + "enter  " + str.tostring(close, format.mintick) + "\nstop   " + str.tostring(sl, format.mintick) + "\ntarget " + str.tostring(tp, format.mintick) + "\nvotes  " + str.tostring(buySig ? bulls : bears) + "/6"
    sigLb := label.new(bar_index, buySig ? low : high, txt, style = buySig ? label.style_label_up : label.style_label_down, color = color.new(buySig ? color.green : color.red, 15), textcolor = color.white, size = size.normal)
plotshape(buySig,  "BUY",  shape.triangleup,   location.belowbar, color.green, size = size.small)
plotshape(sellSig, "SELL", shape.triangledown, location.abovebar, color.red,   size = size.small)

// ================= LIVE "NOW" BIAS BOX (appears/updates/clears) =========
// Anchored to the last bar; redraws every bar so it always reflects the
// CURRENT state and disappears to WAIT the moment alignment is lost.
var label nowLb = na
if barstate.islast
    label.delete(nowLb)
    biasTxt = buyState ? "▲ BUY BIAS NOW" : sellState ? "▼ SELL BIAS NOW" : "WAIT — no aligned setup"
    biasCol = buyState ? color.new(color.green, 10) : sellState ? color.new(color.red, 10) : color.new(color.gray, 30)
    sub = "  " + str.tostring(bulls) + " bull / " + str.tostring(bears) + " bear  ·  ADX " + str.tostring(adxV, "#") + (strongTape ? " (trending)" : " (choppy)")
    nowLb := label.new(bar_index, high, biasTxt + "\n" + sub, style = label.style_label_left, color = biasCol, textcolor = color.white, size = size.large)

// ================= DASHBOARD =================
f_mark(bull, bear) => bull ? "▲ bull" : bear ? "▼ bear" : "— flat"
f_col(bull, bear)  => bull ? color.new(color.green, 72) : bear ? color.new(color.red, 72) : color.new(color.gray, 80)

var table dash = table.new(position.top_right, 2, 13, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.new(color.gray, 70))
if showDash and barstate.islast
    table.cell(dash, 0, 0, "GoldTrader PRO", text_color = color.white, bgcolor = color.new(color.blue, 35))
    table.cell(dash, 1, 0, timeframe.period + "m", text_color = color.white, bgcolor = color.new(color.blue, 35))
    table.cell(dash, 0, 1, "Trend EMA20/75", text_color = color.white, bgcolor = f_col(v1bull, v1bear))
    table.cell(dash, 1, 1, f_mark(v1bull, v1bear), text_color = color.white, bgcolor = f_col(v1bull, v1bear))
    table.cell(dash, 0, 2, "15m trend", text_color = color.white, bgcolor = f_col(v2bull, v2bear))
    table.cell(dash, 1, 2, f_mark(v2bull, v2bear), text_color = color.white, bgcolor = f_col(v2bull, v2bear))
    table.cell(dash, 0, 3, "MACD", text_color = color.white, bgcolor = f_col(v3bull, v3bear))
    table.cell(dash, 1, 3, f_mark(v3bull, v3bear), text_color = color.white, bgcolor = f_col(v3bull, v3bear))
    table.cell(dash, 0, 4, "RSI " + str.tostring(rsiV, "#"), text_color = color.white, bgcolor = f_col(v4bull, v4bear))
    table.cell(dash, 1, 4, f_mark(v4bull, v4bear), text_color = color.white, bgcolor = f_col(v4bull, v4bear))
    table.cell(dash, 0, 5, "Supertrend", text_color = color.white, bgcolor = f_col(v5bull, v5bear))
    table.cell(dash, 1, 5, f_mark(v5bull, v5bear), text_color = color.white, bgcolor = f_col(v5bull, v5bear))
    table.cell(dash, 0, 6, "VWAP side", text_color = color.white, bgcolor = f_col(v6bull, v6bear))
    table.cell(dash, 1, 6, f_mark(v6bull, v6bear), text_color = color.white, bgcolor = f_col(v6bull, v6bear))
    majBull = close > ema200
    table.cell(dash, 0, 7, "EMA200 major", text_color = color.white, bgcolor = f_col(majBull, not majBull))
    table.cell(dash, 1, 7, majBull ? "▲ above" : "▼ below", text_color = color.white, bgcolor = f_col(majBull, not majBull))
    bbPos = close > bbUpper ? "over upper" : close < bbLower ? "under lower" : "inside"
    table.cell(dash, 0, 8, "Bollinger", text_color = color.white, bgcolor = color.new(color.gray, 75))
    table.cell(dash, 1, 8, bbPos, text_color = color.white, bgcolor = color.new(color.gray, 75))
    strengthCol = strongTape ? color.new(color.green, 72) : color.new(color.orange, 68)
    table.cell(dash, 0, 9, "Strength ADX " + str.tostring(adxV, "#"), text_color = color.white, bgcolor = strengthCol)
    table.cell(dash, 1, 9, strongTape ? "trending" : "choppy", text_color = color.white, bgcolor = strengthCol)
    nearRes = array.size(resLines) > 0 ? line.get_y1(array.get(resLines, array.size(resLines) - 1)) : na
    nearSup = array.size(supLines) > 0 ? line.get_y1(array.get(supLines, array.size(supLines) - 1)) : na
    table.cell(dash, 0, 10, "Resistance", text_color = color.white, bgcolor = color.new(color.red, 78))
    table.cell(dash, 1, 10, na(nearRes) ? "—" : str.tostring(nearRes, format.mintick), text_color = color.white, bgcolor = color.new(color.red, 78))
    table.cell(dash, 0, 11, "Support", text_color = color.white, bgcolor = color.new(color.green, 78))
    table.cell(dash, 1, 11, na(nearSup) ? "—" : str.tostring(nearSup, format.mintick), text_color = color.white, bgcolor = color.new(color.green, 78))
    statusTxt = buyState ? "BUY — long setups valid" : sellState ? "SELL — short setups valid" : "WAIT — " + str.tostring(math.max(bulls, bears)) + "/" + str.tostring(votesNeeded) + " aligned"
    statusCol = buyState ? color.new(color.green, 20) : sellState ? color.new(color.red, 20) : color.new(color.gray, 35)
    table.cell(dash, 0, 12, "STATUS", text_color = color.white, bgcolor = statusCol)
    table.cell(dash, 1, 12, statusTxt, text_color = color.white, bgcolor = statusCol)

// ================= ALERTS =================
alertcondition(buySig,  "GoldTrader PRO BUY",  "GoldTrader PRO: BUY XAUUSD — 5+/6 aligned bullish, trend confirmed")
alertcondition(sellSig, "GoldTrader PRO SELL", "GoldTrader PRO: SELL XAUUSD — 5+/6 aligned bearish, trend confirmed")
alertcondition(bullDiv, "GoldTrader PRO bull divergence", "GoldTrader PRO: bullish RSI divergence on XAUUSD")
alertcondition(bearDiv, "GoldTrader PRO bear divergence", "GoldTrader PRO: bearish RSI divergence on XAUUSD")
